# Public site URL used for canonical metadata.
NEXT_PUBLIC_SITE_URL=https://www.atlas-immi.com

# Optional inbox target for future email or CRM integration.
CONTACT_FORM_TO=hoob@atlas-immi.com

# Password for /admin content management. Change this before production use.
ADMIN_PASSWORD=replace-with-a-strong-password

# Postgres database for AI content intake, RAG indexing, chat logs, and feedback.
# Requires pgvector for semantic search.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/atlas

# Set to "none" to force the offline no-op assistant even if a key is present.
# Otherwise the chat provider is Anthropic when ANTHROPIC_API_KEY is set.
AI_PROVIDER=

# Embedding model/provider will be finalized after reviewing real owner-provided documents.
AI_EMBEDDING_MODEL=

# Anthropic API key for the public chat assistant (/api/ai/chat, ai:chat).
ANTHROPIC_API_KEY=

# Chat model for the assistant. Defaults to claude-sonnet-4-6 if unset.
AI_CHAT_MODEL=claude-sonnet-4-6

# Voyage AI key for embeddings (ai:embed).
VOYAGE_API_KEY=

# Salt for hashing visitor IPs in chat logs (PDPA-minimal; set a random value).
VISITOR_HASH_SALT=
