{
  "name": "atlas-immigration-services",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:migrate:ai": "set -a; [ -f .env ] && . ./.env; set +a; for file in db/migrations/*.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$file\"; done",
    "mom:import": "node scripts/import-mom-content.mjs",
    "mom:import:dry-run": "node scripts/import-mom-content.mjs --dry-run",
    "ai:index": "set -a; [ -f .env ] && . ./.env; set +a; tsx scripts/index-knowledge.ts",
    "ai:index:dry-run": "set -a; [ -f .env ] && . ./.env; set +a; tsx scripts/index-knowledge.ts --dry-run",
    "ai:chunk": "set -a; [ -f .env ] && . ./.env; set +a; tsx scripts/chunk-knowledge.ts",
    "ai:chunk:dry-run": "set -a; [ -f .env ] && . ./.env; set +a; tsx scripts/chunk-knowledge.ts --dry-run",
    "ai:search": "set -a; [ -f .env ] && . ./.env; set +a; tsx scripts/search-knowledge.ts",
    "ai:search:hybrid": "set -a; [ -f .env ] && . ./.env; set +a; tsx scripts/search-knowledge.ts --hybrid",
    "ai:embed": "set -a; [ -f .env ] && . ./.env; set +a; tsx scripts/embed-knowledge.ts",
    "ai:embed:dry-run": "set -a; [ -f .env ] && . ./.env; set +a; tsx scripts/embed-knowledge.ts --dry-run",
    "ai:chat": "set -a; [ -f .env ] && . ./.env; set +a; tsx scripts/chat.ts",
    "content:seed": "set -a; [ -f .env ] && . ./.env; set +a; tsx scripts/seed-site-content.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@eslint/eslintrc": "^3.3.5",
    "@types/d3-geo": "^3.1.0",
    "@types/topojson-client": "^3.1.5",
    "@vercel/blob": "^2.7.0",
    "d3-geo": "^3.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "next": "^16.2.9",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-easy-crop": "^6.2.3",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2"
  }
}
